# Copy the values into Portainer's "Environment variables" section — this stack
# uses ${VAR} interpolation only and needs no .env file on the host.

# What this runner serves. A repository URL for RUNNER_SCOPE=repo, an
# organisation URL for RUNNER_SCOPE=org (read the README's security note first).
REPO_URL=https://github.com/<org>/<repo>
RUNNER_SCOPE=repo

# How you find it in Settings → Actions → Runners, and what a workflow asks for.
# Always give a specific label: with only `self-hosted`, any job in scope can
# land here, including jobs this host cannot serve.
RUNNER_NAME=<host>-<purpose>
RUNNER_LABELS=<purpose>

# Settings → Actions → Runners → New self-hosted runner. Expires in one hour,
# single-use. The runner holds its own credentials afterwards.
RUNNER_TOKEN=

# Must differ per stack on the same host, and must be a real host directory you
# created beforehand. See "identical paths" in docker-compose.yml.
RUNNER_WORK_ROOT=/srv/<purpose>-ci/_work

# Optional
# RUNNER_IMAGE=myoung34/github-runner:2.338.0-ubuntu-noble
# RUNNER_EPHEMERAL=false
# PRUNE_KEEP=24h
# PRUNE_EVERY_SECONDS=3600
