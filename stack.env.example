# ─────────────────────────────────────────────────────────────────────────────
# Portainer → Stacks → Add stack → Repository, then open "Advanced mode" under
# Environment variables and paste this whole block in. Fill the four values
# marked REQUIRED; delete the comments or leave them, Portainer ignores them.
#
# Copy to `stack.env` if you deploy with plain `docker compose` instead.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The repository this runner serves. For RUNNER_SCOPE=org use the
# organisation URL instead — and read the README's security section first,
# because an org runner accepts jobs from every repository in it, including
# ones somebody adds later.
REPO_URL=https://github.com/ORG/REPO
RUNNER_SCOPE=repo

# REQUIRED. How you recognise it in Settings → Actions → Runners.
RUNNER_NAME=ci-host-e2e

# REQUIRED. What a workflow asks for: runs-on: [self-hosted, linux, x64, LABEL]
# Always something specific. With only `self-hosted`, any job in scope lands
# here, including jobs this host cannot serve.
RUNNER_LABELS=e2e

# REQUIRED. Settings → Actions → Runners → New self-hosted runner.
# Valid one hour, single-use; the runner holds its own credentials afterwards.
RUNNER_TOKEN=

# REQUIRED to be a real directory you created, and unique per stack on this
# host. Two stacks sharing it overwrite each other's checkouts.
#   sudo mkdir -p /srv/e2e-ci/_work && sudo chown 1000:1000 /srv/e2e-ci/_work
# It appears three times in the compose file — see "identical paths" there.
RUNNER_WORK_ROOT=/srv/e2e-ci/_work

# ── Optional ────────────────────────────────────────────────────────────────

# The runner image. Pin it: a runner that pulls a new image mid-job loses the
# job. Pick the OS your workflows were written against.
RUNNER_IMAGE=myoung34/github-runner:2.338.0-ubuntu-noble

# `true` gives a clean container per job — correct for a public repository or
# one that takes pull requests from forks, at the price of re-downloading
# images, package stores and browsers every run.
RUNNER_EPHEMERAL=false

# How much to keep when pruning, and how often to do it.
PRUNE_IMAGE=docker:29-cli
PRUNE_KEEP=24h
PRUNE_EVERY_SECONDS=3600

# Prune unused volumes too. OFF by default and dangerous on a shared host: a
# volume whose container was removed counts as unused, so this can destroy
# another stack's data. Turn it on only when this host runs nothing but
# runners. See the prune service's comment block.
PRUNE_VOLUMES=false
